classDiagram
    %% Enums for Type Safety (Highly recommended in C++/Rust)
    class TaskStatus {
        <<enumeration>>
        NotStarted
        InProgress
        Completed
        OnHold
    }

    class MasteryLevel {
        <<enumeration>>
        Novice
        Developing
        Proficient
        Mastered
    }

    %% Core Data Model
    class Task {
        -String topic
        -TaskStatus status
        -MasteryLevel masteryLevel
        -Date startDate
        -Date targetCompletionDate
        -Date actualCompletionDate
        -int plannedDurationDays
        -String positionOrExercises
        -String notesAndReflections
        +int getRemainingDays()
        +bool isOverBudget()
        +void addTime(int minutes)
        +void markCompleted()
    }

    %% Business Logic / Controller
    class TaskManager {
        -std::vector~Task~ tasks
        -int completedSteps
        -int totalSteps
        -FileStorage storage
        +void loadTasks()
        +void saveTasks()
        +void addTask(Task t)
        +float getProgressPercentage()
        +void updateProgress(int completed)
        +void updateTaskProgress(String topic, int completedSteps)
        +void updateMastery(String topic, MasteryLevel level)
        +Task getTask(String topic)
        +std::vector~Task~ getAllTasks()
    }

    %% Persistence Layer
    class FileStorage {
        -String filePath
        +std::vector~Task~ readJSON()
        +void writeJSON(std::vector~Task~ tasks)
    }

    %% Slint GUI Integration Layer
    class SlintBridge {
        -TaskManager* manager
        -slint::ComponentHandle ui_handle
        +void initialize()
        +void setupCallbacks()
        +void syncModelsToUI()
    }

    %% Relationships
    TaskManager "1" *-- "*" Task : manages
    TaskManager "1" --> "1" FileStorage : uses for persistence
    SlintBridge "1" --> "1" TaskManager : invokes logic
    Task ..> TaskStatus : has
    Task ..> MasteryLevel : has